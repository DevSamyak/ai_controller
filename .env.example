# LLM Configuration
# Set LLM_PROVIDER to "fake" for offline deterministic testing (no API key needed)
# Set LLM_PROVIDER to "google" for live Gemini execution
LLM_PROVIDER=fake
# Provide your Gemini API key below when LLM_PROVIDER=google (or set GEMINI_API_KEY)
LLM_API_KEY=
# Example models: gemini-2.0-flash, gemini-2.5-flash
LLM_MODEL=

# Service Endpoints
MOCK_COMPANY_URL=http://127.0.0.1:8001
OPERATOR_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Agent Execution Limits & Thresholds
MAX_RETRIES=2
MAX_STEPS=40
REFUND_APPROVAL_THRESHOLD=10000

# Storage Paths
DATABASE_PATH=./data/operator.sqlite3
MOCK_DATABASE_PATH=./data/mock_company.sqlite3
WORKSPACE_PATH=./workspace
LOGS_PATH=./logs/runs
